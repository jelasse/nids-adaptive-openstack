*.zip
models/full_rf/
models/light_lr/

# --- run-control files (no value as evidence) ---
results/**/STOP
results/**/mode

# --- Python / editor clutter ---
__pycache__/
*.pyc
.venv/
spark-venv/
.ipynb_checkpoints/
.DS_Store
